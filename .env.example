# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Get this from https://discord.com/developers/applications -> your app -> Bot -> Token
DISCORD_TOKEN=

# Optional: comma-separated guild IDs for instant slash-command sync while developing.
# Right-click your test server icon -> Copy Server ID (needs Developer Mode enabled).
DEV_GUILD_IDS=

# Optional: comma-separated Discord user IDs allowed to use owner-only commands (e.g. /reload)
OWNER_IDS=

LOG_LEVEL=INFO
